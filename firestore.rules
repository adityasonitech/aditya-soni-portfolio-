rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio content: anyone may read (the public site needs it),
    // nobody may write from a client. Writes go through /api/update-portfolio,
    // which uses the Admin SDK and bypasses these rules.
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin credentials: never readable or writable from a client.
    // /api/login reads this with the Admin SDK.
    match /admin-credential/{document=**} {
      allow read, write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
